# Copiá este archivo como .env y completá los datos de tu instancia SQL Server.
FOODTRACK_DB_SERVER=localhost
FOODTRACK_DB_NAME=FoodTrack
# Usá el mismo usuario configurado en tu conexión de SQL Server (por ejemplo, sa).
FOODTRACK_DB_USER=TU_USUARIO_SQL_SERVER
FOODTRACK_DB_PASSWORD=tu_contrasena
# Opcional. Ejemplo: ODBC Driver 18 for SQL Server
FOODTRACK_DB_DRIVER=ODBC Driver 18 for SQL Server
